# Copy to .env and fill in. Never commit .env.

# Public URL people open (used in Teams cards and ADO ticket links)
PUBLIC_BASE_URL=http://localhost:3000

# Login (ADR-0001): "observ" in production, "dev" accepts any email without a password
AUTH_MODE=observ
OBSERV_BASE_URL=https://lighthouse-production.visionai.linkervision.ai/observ
SESSION_SECRET=           # python -c "import secrets;print(secrets.token_urlsafe(48))"
# Trial allowlist (comma-separated). Empty = anyone with an Observ account.
# Handoff targets must be on it too.
ALLOWED_EMAILS=

# ADO
ADO_ORG=linkerengineer
ADO_PROJECT=Deliver team
ADO_AREA_PATH=Deliver team
ADO_TEAM=Deliver team Team   # Parent choices = User Stories on this team's current iteration
ADO_DEFAULT_PARENT_ID=41152
FERNET_KEY=               # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ADO_DEV_PAT=            # dev only: shared PAT for everyone without their own

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
LLM_MODE=claude           # "claude" (API key) | "claude_code" (owner's own CLI, single-user) | "fake"
# Single-user trial without an API key: the interview runs on the owner's own `claude -p` login.
# Only OWNER_EMAIL can log in and Handoff is disabled, because a personal Claude login
# must not serve other people. Run it with docker-compose.single-user.yml (or scripts/trial.sh).
# OWNER_EMAIL=you@linkervision.com
# CLAUDE_CODE_SHARED=true   # owner's choice: let ALLOWED_EMAILS use the web on the owner's personal Claude
#                           # login (Handoff on). Shares a personal plan and its quota; switch to an API key ASAP.
#                           # Refuses to start without ALLOWED_EMAILS.
# CLAUDE_CODE_MODEL=        # empty = the CLI default
# docker-compose.single-user.yml runs as the owner and mounts their Claude Code login:
# SPRITE_UID=               # id -u
# SPRITE_GID=               # id -g
# CLAUDE_DIR=               # e.g. /home/you/.claude
# KNOWLEDGE_SOURCE_GID=     # group that can read KNOWLEDGE_REPO_SOURCE, if not SPRITE_GID
# OBSERV_IP=                # internal address of OBSERV_BASE_URL's host, as in the VM's /etc/hosts
# OBSERV_HOST=              # that host name, if not lighthouse-production.visionai.linkervision.ai

# Knowledge Source (ADR-0002). The clone tracks KNOWLEDGE_BRANCH of KNOWLEDGE_REPO_SOURCE.
# A local path only sees what that working copy has fetched; a GitHub URL (needs a read-only
# deploy key mounted at /root/.ssh) always gets the real main.
KNOWLEDGE_REPO_SOURCE=/opt/lighthouse-saas-api
KNOWLEDGE_BRANCH=main
KNOWLEDGE_PRODUCT_SUBDIR=apps/visionai_middleware

# Teams Workflows "post to a channel when a webhook request is received" URL
TEAMS_WEBHOOK_URL=
